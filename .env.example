# ===== MOONLINK — copy file này thành .env =====
# Hướng dẫn chi tiết: README.md

# Server
PORT=3000
MOONLINK_MODE=production

# Addlivetag — lấy tại https://addlivetag.com/ (mục API key / tool/conversion)
# Gửi qua header X-API-Key
ADDLIVETAG_API_KEY=

# Affiliate ID (affiliate_id trên link an_redir) — từ dashboard Shopee Affiliate của bạn
SHOPEE_AFFILIATE_ID=

# Endpoint mặc định (đổi nếu tài liệu API thay đổi)
PRODUCT_API_BASE=https://data.addlivetag.com/product-data/product-data.php
CONVERSIONS_API_BASE=https://addlivetag.com/api/v1/conversions.php

# Admin — chỉ tạo user lần đầu khi chưa có trong DB (mật khẩu ≥ 10 ký tự)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=8

# Cookie Secure=1 khi deploy HTTPS. Local HTTP để trống.
COOKIE_SECURE=0
# Origin được phép gọi login admin (phân tách dấu phẩy)
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Cashback dự kiến = floor(hoa_hồng_đã_chuẩn_hóa × %chia_lại / 100)
# hoa_hồng_đã_chuẩn_hóa = sellerComFinal + shopeeComFinal (docs product-data)
CASHBACK_SHARE_PERCENT=70

# Tỷ lệ hoa hồng sàn Shopee của tài khoản affiliate (docs: 0.08 hoặc 8).
# Để trống = API tự lấy rate (mặc định config ~3.5%).
# SHOPEE_BASE_RATE=

# Trần raw hoa hồng Shopee (docs cap 40000 từ 22/06/2026)
# SHOPEE_CAP_RAW=40000

# % phí MCN trừ trước khi chia cashback. 0 = không trừ (theo PRODUCT-DESIGN).
MCN_FEE_PERCENT=0

# Log API/DB/outbound Addlivetag ở dev: 1=bật, 0=tắt (mặc định ON khi NODE_ENV != production)
# LOG_API=1
